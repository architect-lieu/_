page { background: #fffaf5; color: #332f2c; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { min-height: 100vh; box-sizing: border-box; }
.brand { display: flex; align-items: center; gap: 16rpx; font-size: 34rpx; font-weight: 700; color: #524d48; }
.brand-mark { color: #ff9d5c; font-size: 46rpx; line-height: 1; }
.section-title { font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.section-kicker { color: #e98747; font-size: 22rpx; letter-spacing: 4rpx; margin-bottom: 12rpx; }
.muted { color: #817b75; }
.primary-btn { background: linear-gradient(135deg, #ffb06e, #f58a43); color: #fff; border-radius: 999rpx; font-weight: 700; border: 0; }
.primary-btn::after { border: 0; }
.ghost-btn { background: #f4eee8; color: #665f59; border-radius: 999rpx; border: 0; }
.ghost-btn::after { border: 0; }
.card { background: #fff; border-radius: 32rpx; box-shadow: 0 16rpx 50rpx rgba(94, 69, 48, .08); }
