<view class="page profile-page"><view class="profile-head"><view class="avatar">回</view><view class="user"><view class="name">{{user?'回音录用户':'还没有登录'}}</view><view class="tip">{{user?'你的故事和订单已受账号保护':'登录后查看自己的故事与进度'}}</view></view><button wx:if="{{!user}}" class="login-mini" bindtap="login" loading="{{loading}}">登录</button></view>
<view class="quick card"><view><text>{{counts.orders}}</text><text>订单</text></view><view><text>{{counts.recordings}}</text><text>讲述</text></view><view><text>0</text><text>家庭成员</text></view></view>
<view class="menu card"><view wx:for="{{menus}}" wx:key="title" class="menu-row" data-index="{{index}}" bindtap="tapMenu"><text class="menu-icon">{{item.icon}}</text><text>{{item.title}}</text><text class="chevron">›</text></view></view>
<view class="version">AI回音录 · MVP</view></view>
