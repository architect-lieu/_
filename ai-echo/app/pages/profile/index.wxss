.profile-page{padding:64rpx 30rpx}.profile-head{display:flex;align-items:center}.avatar{width:112rpx;height:112rpx;border-radius:50%;background:linear-gradient(135deg,#ffc18b,#ef8a46);display:flex;align-items:center;justify-content:center;color:#fff;font-size:42rpx}.user{margin-left:24rpx;flex:1}.name{font-size:36rpx;font-weight:700}.tip{font-size:22rpx;color:#8d8680;margin-top:10rpx}.login-mini{font-size:24rpx;border-radius:99rpx;background:#fff0e3;color:#dc7434}.login-mini::after{border:0}.quick{margin:48rpx 0 26rpx;padding:30rpx 10rpx;display:flex}.quick view{flex:1;display:flex;flex-direction:column;text-align:center;border-right:1px solid #eee4db}.quick view:last-child{border:0}.quick text:first-child{font-size:36rpx;font-weight:700;color:#ef8a46}.quick text:last-child{font-size:22rpx;color:#89827b;margin-top:8rpx}.menu{overflow:hidden}.menu-row{height:106rpx;display:flex;align-items:center;border-bottom:1px solid #f0e8e1;padding:0 30rpx}.menu-row:last-child{border:0}.menu-icon{width:58rpx;color:#ef8a46;font-size:34rpx}.chevron{margin-left:auto;color:#bbb;font-size:40rpx}.version{text-align:center;color:#aaa29b;font-size:22rpx;margin-top:54rpx}
