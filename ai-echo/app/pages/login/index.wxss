.login-page{padding:120rpx 54rpx;text-align:center}.login-mark{margin:auto;width:142rpx;height:142rpx;border-radius:38rpx;background:linear-gradient(135deg,#ffbd83,#ef8843);display:flex;align-items:center;justify-content:center;color:white;font-size:58rpx;box-shadow:0 20rpx 45rpx rgba(229,123,55,.22)}.login-title{font-size:42rpx;font-weight:700;margin-top:48rpx}.login-sub{color:#89827c;margin-top:18rpx;line-height:1.7}.wechat-btn{margin-top:100rpx;background:#07c160;color:#fff;border-radius:999rpx;font-weight:700}.wechat-btn::after{border:0}.agreement{margin-top:32rpx;font-size:22rpx;color:#89827c;display:flex;align-items:center;justify-content:center}.check{width:28rpx;height:28rpx;border:1px solid #bbb;border-radius:50%;margin-right:10rpx;display:inline-flex;align-items:center;justify-content:center}.checked{background:#ef8a46;color:white;border-color:#ef8a46}.link{color:#e47f3d}.demo-note{margin-top:100rpx;color:#aaa29b;font-size:22rpx}
