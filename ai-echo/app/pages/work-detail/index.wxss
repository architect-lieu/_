.detail-page{padding:60rpx 34rpx 100rpx}.empty{text-align:center;color:#999;padding-top:180rpx}.ai-note{font-size:22rpx;color:#b06a3e}.title{font-size:48rpx;font-weight:700;line-height:1.35;margin-top:28rpx}.summary{color:#837b74;line-height:1.7;margin-top:22rpx;padding-bottom:34rpx;border-bottom:1px solid #eee3da}.content{white-space:pre-wrap;font-size:31rpx;line-height:2;color:#403b37;margin-top:38rpx}.uncertain,.source{padding:28rpx;margin-top:36rpx;color:#6f6862;line-height:1.8}.uncertain{background:#fff5e9}.source{background:#f5f2ef}.uncertain-title,.source-title{font-weight:700;color:#332f2c;margin-bottom:12rpx}.edit,.confirm,.export{margin-top:22rpx;border-radius:99rpx;font-weight:700}.edit{background:#fff0e4;color:#d27339}.confirm{background:#3f7f68;color:#fff}.export{background:#eeeae6;color:#aaa}.edit::after,.confirm::after,.export::after{border:0}.title-input{font-size:42rpx;font-weight:700;border-bottom:1px solid #ddd;padding:24rpx 0}.content-input{width:100%;box-sizing:border-box;min-height:520rpx;margin-top:28rpx;padding:28rpx;background:#f6f2ee;border-radius:20rpx;line-height:1.8}.actions{display:flex;gap:20rpx;margin-top:28rpx}.actions button{flex:1;border-radius:99rpx}.ghost{background:#eeeae6}.primary{background:#ed8b4c;color:#fff}
