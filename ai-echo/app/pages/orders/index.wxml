<view class="page orders-page">
  <view class="section-title">我的订单</view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{!orders.length}}" class="empty">还没有订单</view>
  <view wx:for="{{orders}}" wx:key="orderNo" class="order card">
    <view class="order-head"><text>{{item.productName}}</text><text class="status">{{item.statusText}}</text></view>
    <view class="order-meta">订单号 {{item.orderNo}}</view>
    <view class="order-bottom"><text>{{item.createdAtText}}</text><text class="price">¥{{item.amountYuan}}</text></view>
  </view>
</view>
