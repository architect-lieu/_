<view class="page works-page">
  <view class="topbar"><view class="brand"><text class="brand-mark">▤</text><text>AI回音录</text></view></view>
  <view class="hero card">
    <image class="hero-image" src="/assets/family-walk.jpg" mode="aspectFill" />
    <view class="hero-shade"></view>
    <view class="hero-copy">
      <view class="hero-count">1 / 4</view>
      <view class="hero-title">把父母的一生<br/>写成一本书</view>
      <view class="hero-sub">真人访谈 · AI 整理 · 人工把关</view>
      <button class="hero-btn" bindtap="startStory">开始讲述</button>
    </view>
  </view>
  <view wx:if="{{works.length}}" class="my-works">
    <view class="section-kicker">MY STORIES</view>
    <view class="section-title">我的故事</view>
    <view wx:for="{{works}}" wx:key="id" class="work-card card" data-id="{{item.id}}" bindtap="openWork">
      <view class="work-state">{{item.statusText}}</view>
      <view class="work-title">{{item.title}}</view>
      <view class="work-summary">{{item.summary}}</view>
      <view class="work-more">查看故事 ›</view>
    </view>
  </view>
  <view class="intro">
    <view class="section-kicker">EVERY LIFE MATTERS</view>
    <view class="section-title">每个人的瞬间，都值得被认真铭记</view>
    <view class="intro-grid">
      <view><text class="number">12</text><text class="label">个温柔问题</text></view>
      <view><text class="number">1</text><text class="label">张故事卡起步</text></view>
      <view><text class="number">∞</text><text class="label">份家庭回忆</text></view>
    </view>
  </view>
  <view class="sample card">
    <image src="/assets/old-photo.jpg" mode="aspectFill" />
    <view class="sample-copy"><text class="sample-tag">回音故事卡</text><text class="sample-title">外婆的红糖茶罐</text><text class="sample-text">从一张照片、一段声音开始，留下那些看似平常却无法重来的细节。</text></view>
  </view>

  <view wx:if="{{showPrivacy}}" class="mask">
    <view class="privacy-dialog">
      <view class="dialog-title">小程序隐私保护说明</view>
      <view class="dialog-text">欢迎来到 AI回音录。正式使用前，请阅读<text class="link" bindtap="openPrivacy">《AI回音录隐私政策》</text>。只有你主动操作时，录音和文字才会上传并用于转写与故事整理。</view>
      <view class="dialog-actions"><button class="ghost-btn" bindtap="rejectPrivacy">稍后</button><button class="primary-btn" bindtap="acceptPrivacy">同意</button></view>
    </view>
  </view>
</view>
