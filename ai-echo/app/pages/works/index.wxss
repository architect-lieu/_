.works-page { padding: 0 28rpx 60rpx; }
.topbar { padding: 78rpx 8rpx 24rpx; }
.hero { height: 770rpx; position: relative; overflow: hidden; }
.hero-image,.hero-shade { position:absolute; inset:0; width:100%; height:100%; }
.hero-shade { background: linear-gradient(180deg, rgba(22,27,29,.08), rgba(26,20,16,.78)); }
.hero-copy { position:absolute; inset:0; padding:44rpx; display:flex; flex-direction:column; justify-content:flex-end; color:#fff; }
.hero-count { position:absolute; right:34rpx; top:32rpx; padding:10rpx 20rpx; border-radius:999rpx; background:rgba(255,255,255,.2); }
.hero-title { font-size:58rpx; line-height:1.25; font-weight:700; }
.hero-sub { margin:22rpx 0 34rpx; color:rgba(255,255,255,.82); }
.hero-btn { margin:0; width:240rpx; color:#74401f; background:#ffb06c; border-radius:999rpx; font-weight:700; }
.hero-btn::after { border:0; }
.intro { padding:80rpx 12rpx 62rpx; }
.intro-grid { margin-top:44rpx; display:flex; justify-content:space-between; }
.intro-grid>view { flex:1; display:flex; flex-direction:column; align-items:center; border-right:1px solid #e8ddd4; }
.intro-grid>view:last-child { border:0; }
.number { color:#ee8d4c; font-size:46rpx; font-weight:700; }.label { margin-top:8rpx; font-size:22rpx; color:#817b75; }
.sample { overflow:hidden; }.sample image { width:100%; height:330rpx; }.sample-copy { padding:32rpx; display:flex; flex-direction:column; gap:14rpx; }
.my-works{padding:12rpx 0 64rpx}.my-works>.section-title{margin:12rpx 0 30rpx}.work-card{padding:32rpx;margin-bottom:22rpx}.work-state{font-size:20rpx;color:#df7f43}.work-title{font-size:34rpx;font-weight:700;margin-top:12rpx}.work-summary{color:#77716b;line-height:1.7;margin-top:14rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden}.work-more{text-align:right;color:#df7f43;font-size:23rpx;margin-top:22rpx}
.sample-tag { color:#e98747; font-size:22rpx; }.sample-title { font-size:36rpx; font-weight:700; }.sample-text { color:#77716b; line-height:1.7; }
.mask { position:fixed; inset:0; z-index:20; background:rgba(0,0,0,.58); display:flex; align-items:center; justify-content:center; padding:44rpx; }
.privacy-dialog { width:100%; background:#fff; border-radius:38rpx; padding:54rpx 44rpx 42rpx; box-sizing:border-box; }
.dialog-title { text-align:center; font-size:38rpx; font-weight:700; }.dialog-text { margin:34rpx 0 44rpx; line-height:1.8; color:#625e5a; }.link { color:#ed8c4c; }
.dialog-actions { display:flex; gap:22rpx; }.dialog-actions button { width:50%; }
