<view class="page story-page">
  <view class="section-kicker">回音十二问 · 第 1 问</view>
  <view class="section-title">{{question}}</view>
  <view class="hint">不用组织得很完整，像聊天一样慢慢说就好。</view>

  <view class="recorder card {{status === 'recording' ? 'is-recording' : ''}}">
    <view class="pulse-wrap"><view class="pulse"></view><view class="mic">{{status === 'ready' || status === 'saved' ? '✓' : '●'}}</view></view>
    <view class="timer">{{elapsedText}}</view>
    <view class="status">{{statusText}}</view>
    <view class="limit">最长 10 分钟 · 单声道 MP3</view>
    <view wx:if="{{status === 'recording' || status === 'paused'}}" class="bars">
      <text wx:for="{{bars}}" wx:key="*this" class="bar-{{index % 5}}"></text>
    </view>
  </view>

  <view wx:if="{{status === 'idle' || status === 'starting'}}" class="main-actions">
    <button class="record-btn {{status === 'starting' ? 'starting-btn' : ''}}" bindtap="handleMainAction"><text>{{status === 'starting' ? '×' : '●'}}</text> {{status === 'starting' ? '取消并重试' : '开始录音'}}</button>
  </view>
  <view wx:elif="{{status === 'recording' || status === 'paused'}}" class="record-actions">
    <button class="pause-btn" bindtap="handleMainAction">{{status === 'recording' ? 'Ⅱ 暂停' : '▶ 继续'}}</button>
    <button class="stop-btn" bindtap="stopRecording">■ 结束录音</button>
  </view>
  <view wx:else class="result card">
    <view class="result-head"><view><view class="result-title">本次讲述</view><view class="result-meta">{{durationText}} · {{fileSizeText}}</view></view><view class="saved-tag" wx:if="{{status === 'saved'}}">已保存</view></view>
    <view class="result-actions"><button class="play-btn" bindtap="togglePlayback">{{isPlaying ? 'Ⅱ 暂停试听' : '▶ 试听录音'}}</button><button class="delete-btn" bindtap="discard">删除重录</button></view>
    <button class="confirm-btn" bindtap="confirmRecording">{{status === 'saved' ? '已保存到本机' : '确认本次讲述'}}</button>
    <button wx:if="{{status === 'saved' && uploadStatus !== 'uploaded'}}" class="cloud-btn" loading="{{uploadStatus === 'uploading'}}" disabled="{{uploadStatus === 'uploading'}}" bindtap="uploadToCloud">{{uploadStatus === 'uploading' ? '正在上传 ' + uploadProgress + '%' : '上传到私有云存储'}}</button>
    <view wx:if="{{uploadStatus === 'uploaded'}}" class="cloud-success">✓ 云端保存成功，等待语音转写</view>
    <button wx:if="{{uploadStatus === 'uploaded' && transcriptStatus !== 'completed'}}" class="asr-btn" loading="{{transcriptStatus === 'starting' || transcriptStatus === 'processing'}}" disabled="{{transcriptStatus === 'starting' || transcriptStatus === 'processing'}}" bindtap="startTranscription">{{transcriptStatus === 'processing' ? '正在转成文字…' : '开始语音转文字'}}</button>
    <view wx:if="{{transcriptStatus === 'completed'}}" class="transcript-box"><view class="transcript-title">原始转写稿</view><text user-select="true">{{transcript}}</text></view>
    <button wx:if="{{transcriptStatus === 'completed' && storyStatus !== 'completed'}}" class="story-btn" loading="{{storyStatus === 'generating'}}" disabled="{{storyStatus === 'generating'}}" bindtap="generateStory">{{storyStatus === 'generating' ? '正在整理故事…' : '整理成精华故事'}}</button>
    <view wx:if="{{storyDraft}}" class="story-preview">
      <view class="story-label">AI 根据你的讲述整理 · 待确认</view>
      <view class="story-title">{{storyDraft.title}}</view>
      <view class="story-summary">{{storyDraft.summary}}</view>
      <button class="open-story-btn" bindtap="openStoryDraft">查看并确认故事</button>
    </view>
  </view>

  <view class="topics-title">也可以换个话题</view>
  <view class="topics"><view wx:for="{{questions}}" wx:key="topic" class="topic {{selected === index ? 'active' : ''}}" data-index="{{index}}" bindtap="choose">{{item.topic}}</view></view>
  <view class="safe-note">🔒 只有你主动点击上传，录音才会进入私有云存储。</view>
</view>
