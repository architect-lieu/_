.story-page { padding:58rpx 34rpx 80rpx; }
.hint { color:#817b75; margin-top:22rpx; line-height:1.7; }
.recorder { margin-top:54rpx; min-height:390rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#706a65; position:relative; overflow:hidden; }
.pulse-wrap { width:126rpx; height:126rpx; position:relative; display:flex; align-items:center; justify-content:center; }
.pulse { position:absolute; inset:0; border-radius:50%; background:#fff0e4; }
.mic { position:relative; width:84rpx; height:84rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg,#ffb06e,#f58a43); color:#fff; font-size:28rpx; box-shadow:0 12rpx 30rpx rgba(238,130,63,.26); }
.is-recording .pulse { animation:pulse 1.7s infinite; }.is-recording .mic { background:#ef6c4d; }
@keyframes pulse { 0%{transform:scale(.9);opacity:.9} 70%{transform:scale(1.35);opacity:.15} 100%{transform:scale(1.35);opacity:0} }
.timer { margin-top:26rpx; font-size:58rpx; font-weight:700; letter-spacing:3rpx; color:#403b37; }
.status { margin-top:10rpx; font-size:27rpx; }.limit { margin-top:10rpx; font-size:20rpx; color:#aaa29b; }
.bars { height:48rpx; margin-top:22rpx; display:flex; align-items:center; gap:7rpx; }.bars text { display:block; width:6rpx; border-radius:9rpx; background:#f09a61; animation:wave .8s ease-in-out infinite alternate; }.bars text:nth-child(2n){animation-delay:.2s}.bars text:nth-child(3n){animation-delay:.4s}
.bars .bar-0{height:18rpx}.bars .bar-1{height:28rpx}.bars .bar-2{height:38rpx}.bars .bar-3{height:48rpx}.bars .bar-4{height:58rpx}
@keyframes wave{from{transform:scaleY(.55);opacity:.5}to{transform:scaleY(1.3);opacity:1}}
.record-btn { margin-top:34rpx; background:linear-gradient(135deg,#ffb06e,#f58a43); color:white; border-radius:999rpx; font-weight:700; }.record-btn::after{border:0;}.record-btn text { margin-right:12rpx; }
.test-import-btn{margin-top:18rpx;background:#f5f2ef;color:#736c66;border:1px dashed #c9bdb3;border-radius:99rpx;font-size:24rpx}.test-import-btn::after{border:0}
.starting-btn{background:#f3e2d5;color:#9a603c}
.record-actions { display:flex; gap:18rpx; margin-top:30rpx; }.record-actions button { flex:1; border-radius:999rpx; font-size:28rpx; }.pause-btn{background:#fff;color:#d27840;border:1px solid #f3c5a6}.pause-btn::after{border:0}.stop-btn{background:#453f3b;color:white}.stop-btn::after{border:0}
.result { margin-top:28rpx; padding:30rpx; }.result-head{display:flex;justify-content:space-between;align-items:center}.result-title{font-size:30rpx;font-weight:700}.result-meta{font-size:22rpx;color:#989089;margin-top:8rpx}.saved-tag{color:#4a9070;background:#e8f5ee;border-radius:99rpx;padding:8rpx 18rpx;font-size:21rpx}.result-actions{display:flex;gap:16rpx;margin-top:28rpx}.result-actions button{flex:1;font-size:25rpx;border-radius:99rpx}.play-btn{background:#fff0e5;color:#d5783f}.delete-btn{background:#f5f2ef;color:#7e7771}.result-actions button::after{border:0}.confirm-btn{margin-top:20rpx;background:#ed8b4c;color:#fff;border-radius:99rpx;font-weight:700}.confirm-btn::after{border:0}
.cloud-btn{margin-top:18rpx;background:#edf5f2;color:#3e8067;border-radius:99rpx;font-weight:700}.cloud-btn::after{border:0}.cloud-success{margin-top:22rpx;text-align:center;color:#3e8067;font-size:24rpx}
.asr-btn{margin-top:18rpx;background:#3f7f68;color:#fff;border-radius:99rpx;font-weight:700}.asr-btn::after{border:0}.transcript-box{margin-top:26rpx;padding:28rpx;background:#f6f2ee;border-radius:22rpx;color:#5f5954;line-height:1.8}.transcript-head{display:flex;justify-content:space-between;align-items:center;font-size:21rpx;color:#8a817a}.transcript-title{font-weight:700;color:#302d2a;font-size:28rpx}.transcript-preview{position:relative;max-height:216rpx;overflow:hidden;margin-top:18rpx}.transcript-preview::after{content:"";position:absolute;left:0;right:0;bottom:0;height:70rpx;background:linear-gradient(transparent,#f6f2ee)}.transcript-scroll{height:420rpx;margin-top:18rpx;padding-right:8rpx;box-sizing:border-box}
.story-btn{margin-top:18rpx;background:#284f61;color:#fff;border-radius:99rpx;font-weight:700}.story-btn::after{border:0}.story-preview{margin-top:26rpx;padding:30rpx;background:#fff6ed;border:1px solid #f1dac6;border-radius:22rpx}.story-label{font-size:20rpx;color:#b16c3f}.story-title{font-size:34rpx;font-weight:700;margin-top:14rpx}.story-summary{color:#6d655e;line-height:1.7;margin-top:12rpx}.open-story-btn{margin-top:24rpx;background:#ed8b4c;color:#fff;border-radius:99rpx;font-size:25rpx}.open-story-btn::after{border:0}
.topics-title { font-weight:700; margin:60rpx 0 24rpx; }
.topics { display:flex; flex-wrap:wrap; gap:18rpx; }.topic { padding:18rpx 28rpx; background:#f4eee8; border-radius:999rpx; color:#77716b; font-size:25rpx; }.topic.active { color:#a45323; background:#ffe1c7; }
.safe-note { margin-top:52rpx; color:#938b84; font-size:23rpx; text-align:center; }
